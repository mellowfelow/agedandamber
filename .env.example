# Zoho SMTP — order / contact / wholesale notifications (src/utils/notify.ts).
# Required for any outbound mail; without them everything still works, mail
# just doesn't send (logged to the function log instead).
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ORDER_NOTIFY_EMAIL=

# Reply Portal (/admin dashboard) — server-only, never NEXT_PUBLIC_*.
ADMIN_PASSCODE=

# Upstash Redis — orders + enquiries store for the Reply Portal. Create from
# the Vercel Storage tab ("Connect Database" / "Create Database" -> Upstash
# Redis) and connect it to this project; the exact var names it generates
# depend on the "Custom Environment Variable Prefix" you set at connect time,
# so src/lib/redis.ts checks several observed patterns:
#   UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
#   KV_REST_API_URL / KV_REST_API_TOKEN
#   STORAGE_REST_API_URL / STORAGE_REST_API_TOKEN
#   STORAGE_KV_REST_API_URL / STORAGE_KV_REST_API_TOKEN
#   <PREFIX>_KV_REST_API_URL / <PREFIX>_KV_REST_API_TOKEN  (confirmed live
#     2026-09-23 with prefix "UPSTASH_REDIS" — Vercel inserts its own "_KV_"
#     segment even when the prefix already says "REDIS")
UPSTASH_REDIS_KV_REST_API_URL=
UPSTASH_REDIS_KV_REST_API_TOKEN=
