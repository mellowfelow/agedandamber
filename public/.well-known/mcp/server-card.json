{
  "$schema": "https://modelcontextprotocol.io/schemas/server-card/v1.json",
  "serverInfo": {
    "name": "Aged And Amber",
    "version": "1.0.0",
    "description": "Napa Valley's Allocated Spirits, Fine Wine & Rare Beverage Cellar",
    "homepage": "https://www.agedandamber.com",
    "contact": {
      "email": "concierge@agedandamber.com",
      "phone": "+1 (562) 732-4044"
    }
  },
  "transport": {
    "type": "streamable-http",
    "endpoint": "https://www.agedandamber.com/api/mcp/"
  },
  "capabilities": {
    "tools": [
      {
        "name": "search_products",
        "description": "Search spirits by keyword, category, max_price",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": { "type": "string" },
            "category": { "type": "string" },
            "max_price": { "type": "number" }
          }
        }
      },
      {
        "name": "get_product",
        "description": "Get full product details by slug",
        "inputSchema": {
          "type": "object",
          "required": ["slug"],
          "properties": {
            "slug": { "type": "string" }
          }
        }
      },
      {
        "name": "list_categories",
        "description": "List all spirits categories",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "get_policies",
        "description": "Get shipping, payment, returns policies",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "create_order_draft",
        "description": "Create prefilled order URL for adult 21+ verification. Human completes payment.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "items": { "type": "array" },
            "notes": { "type": "string" }
          }
        }
      }
    ],
    "resources": [
      {
        "name": "product-catalog",
        "description": "Full product catalog",
        "uri": "https://www.agedandamber.com/shop/"
      },
      {
        "name": "wholesale",
        "description": "Wholesale pricing and barrel picks",
        "uri": "https://www.agedandamber.com/wholesale/"
      },
      {
        "name": "blog",
        "description": "Spirits education journal",
        "uri": "https://www.agedandamber.com/blog/"
      }
    ],
    "commerce": {
      "ordering": "human-assisted-order-form",
      "payment": ["applepay", "cashapp", "chime", "crypto-BTC", "crypto-USDT", "bank-transfer"],
      "currency": "USD",
      "minimumOrder": "200",
      "freeShipping": "300"
    }
  },
  "legal": {
    "ageRestriction": "21+",
    "productType": "Spirits, Wine, Champagne, Beer, Cider & Non-Alcoholic Beverages",
    "compliance": "Mandatory 21+ adult signature upon carrier delivery."
  }
}
